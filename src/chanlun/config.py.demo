# Web 端缠论计算的最大K线数量（只重放最近 N 根，0 表示不限制）
# 分钟级周期 10000 根全量重放需数分钟，会导致 web 请求超时黑屏；
# 截断为最近 N 根后首次计算降到几十秒内，且只影响图表早期的缠论结构显示
CL_CALC_MAX_KLINES = 3000

def get_data_path():
    # 获取项目数据的目录
    data_path = pathlib.Path(DATA_PATH)
    if DATA_PATH.startswith("."):
        data_path = pathlib.Path().home() / DATA_PATH
    if data_path.is_dir() is False:
        data_path.mkdir(parents=True)
    return data_path
